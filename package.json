{
  "name": "n8n-nodes-qrsalt",
  "version": "0.1.5",
  "description": "QRSalt nodes for n8n: generate QR codes and short links, render and read QR code images, re-point a printed QR code, read its scan analytics, and trigger on every scan.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "qr",
    "qr code",
    "qr-code",
    "qrcode",
    "qr code generator",
    "qr generator",
    "qr code api",
    "qr scanner",
    "qr reader",
    "barcode",
    "barcode reader",
    "barcode scanner",
    "ean13",
    "code128",
    "datamatrix",
    "pdf417",
    "dynamic qr",
    "short link",
    "url shortener",
    "analytics"
  ],
  "license": "MIT",
  "homepage": "https://qrsalt.com/qr-code-api",
  "author": {
    "name": "QRSalt",
    "email": "support@qrsalt.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QRSalt/n8n-nodes-qrsalt.git"
  },
  "bugs": {
    "url": "https://github.com/QRSalt/n8n-nodes-qrsalt/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "scan": "scan-community-package n8n-nodes-qrsalt",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/QrSaltApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/QrSalt/QrSalt.node.js",
      "dist/nodes/QrSalt/QrSaltTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.48.4",
    "@n8n/scan-community-package": "^0.36.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
