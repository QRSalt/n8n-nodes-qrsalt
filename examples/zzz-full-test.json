    {
      "parameters": {
        "jsCode": "// Builds one item with one string field, \"report\", to copy in a single click.\nconst pad = (s) => (s + '                          ').slice(0, 22);\nconst lines = [];\nconst failures = [];\nconst notes = [];\n\nconst grab = (n) => { try { const a = $(n).all(); return a.length ? (a[0].json || {}) : {}; } catch (e) { return { __missing: e.message }; } };\nconst bin = (n) => { try { const a = $(n).all(); return a.length ? (a[0].binary || {}) : {}; } catch (e) { return {}; } };\n\nfunction errOf(j) {\n  if (!j) return 'no output';\n  if (j.__missing) return 'node did not run (' + j.__missing + ')';\n  const e = j.error;\n  if (!e) return null;\n  if (typeof e === 'string') return e;\n  if (typeof e === 'object') return e.message || e.description || JSON.stringify(e).slice(0, 200);\n  return String(e);\n}\n\nfunction fileInfo(b) {\n  const f = b && b.data;\n  if (!f) return 'NO BINARY FIELD \"data\"';\n  let bytes = null;\n  try { if (f.data) bytes = Buffer.from(f.data, 'base64').length; } catch (e) {}\n  return (f.mimeType || '?') + ' ' + (bytes != null ? bytes + ' B' : (f.fileSize || 'size unknown'));\n}\n\nconst n = (x) => (x === undefined || x === null ? '?' : x);\nconst count = (j) => (Array.isArray(j.data) ? j.data.length : (j.meta && j.meta.total != null ? j.meta.total : '?'));\n\nfunction row(label, node, describe) {\n  const j = grab(node);\n  const e = errOf(j);\n  if (e) {\n    failures.push(label + ' — ' + String(e).replace(/\\s+/g, ' ').slice(0, 300));\n    lines.push(pad(label) + 'FAIL  ' + String(e).replace(/\\s+/g, ' ').slice(0, 180));\n    return;\n  }\n  let note = '';\n  try { note = describe ? String(describe(j, bin(node)) ?? '') : ''; }\n  catch (err) { note = '(could not summarise: ' + err.message + ')'; }\n  lines.push(pad(label) + 'ok    ' + note);\n}\n\nrow('render', 'Render', (j, b) => fileInfo(b));\nrow('renderFree', 'Render (Free)', (j, b) => fileInfo(b));\nrow('readFree', 'Read (Free)', (j) => {\n  const keys = ['success', 'data', 'format', 'version', 'errorCorrection', 'mask'];\n  const missing = keys.filter((k) => !(k in j));\n  return 'text=\"' + String(j.data || '').slice(0, 40) + '\" format=' + n(j.format) +\n    (missing.length ? '  SHAPE MISMATCH, missing: ' + missing.join(',') : '');\n});\nrow('codeCreate', 'Create QR Code', (j) => 'id=' + n(j.data && j.data.id) + ' slug=' + n(j.data && j.data.slug) + ' link=' + n(j.data && j.data.shortUrl));\nrow('codeCreateB', 'Create QR Code B', (j) => 'id=' + n(j.data && j.data.id));\nrow('scanFired', 'Fire a Scan', (j) => 'HTTP ' + n(j.statusCode) + ' on the short link (a real scan)');\nrow('codeGet', 'Get QR Code', (j) => 'name=' + n(j.data && j.data.name) + ' status=' + n(j.data && j.data.status));\nrow('codeUpdate', 'Update QR Code', (j) => 'destination=' + String((j.data && j.data.destination) || '?').slice(0, 50));\nrow('codeGetImage', 'Get QR Image', (j, b) => fileInfo(b));\nrow('codeGetScans', 'Get Scans', (j) => (j.data && j.data.summary ? j.data.summary.scans + ' scans, ' + j.data.summary.uniques + ' unique' : 'NO summary in payload'));\nrow('codeGetMany', 'Get Many QR Codes', (j) => count(j) + ' codes from this run');\nrow('codeChangeMany', 'Change Many', (j) => (j.data ? 'action=' + n(j.data.action) + ' done=' + n(j.data.done) + ' unchanged=' + n(j.data.unchanged) + ' skipped=' + n(j.data.skipped) : 'NO data'));\nrow('linkCreate', 'Create Short Link', (j) => 'id=' + n(j.data && j.data.id) + ' link=' + n(j.data && j.data.shortUrl));\nrow('linkGetMany', 'Get Many Short Links', (j) => count(j) + ' links from this run');\nrow('analytics', 'Get Analytics', (j) => (j.data && j.data.summary\n  ? j.data.summary.scans + ' scans / ' + (j.data.series ? j.data.series.length : '?') + ' days' +\n    (j.data.breakdown ? ', breakdown ' + (Array.isArray(j.data.breakdown) ? j.data.breakdown.length + ' rows' : 'present') : ', NO breakdown returned')\n  : 'NO summary'));\nrow('folderCreate', 'Create Folder', (j) => 'id=' + n(j.data && j.data.id) + ' name=' + n(j.data && j.data.name));\nrow('folderGetMany', 'Get Many Folders', (j) => count(j) + ' folders');\nrow('tagGetMany', 'Get Many Tags', (j) => count(j) + ' tags');\nrow('utmGetMany', 'Get Many UTM Presets', (j) => count(j) + ' presets');\nrow('formGetMany', 'Get Many Forms', (j) => count(j) + ' forms');\n\nconst forms = grab('Get Many Forms');\nif (Array.isArray(forms.data) && forms.data.length > 0) {\n  row('formResponses', 'Get Form Responses', (j) => count(j) + ' responses');\n} else {\n  lines.push(pad('formResponses') + 'skip  no QR Form exists in this workspace, so there is nothing to read');\n}\n\nrow('menuGetMany', 'Get Many QR Menus', (j) => count(j) + ' menus');\nrow('codeDelete', 'Delete QR Code', (j) => 'status now ' + n(j.data && j.data.status));\nrow('codeBulkDelete', 'Bulk Delete QR Code B', (j) => (j.data ? 'done=' + n(j.data.done) : 'NO data'));\nrow('linkDelete', 'Delete Short Link', (j) => 'status now ' + n(j.data && j.data.status));\nrow('folderDelete', 'Delete Folder', (j) => (j.data ? 'deleted, ' + n(j.data.codesUnfiled) + ' codes moved out of it (none deleted)' : 'NO data'));\n\nconst removed = [];\nif (!errOf(grab('Delete QR Code'))) removed.push('QR code A');\nif (!errOf(grab('Bulk Delete QR Code B'))) removed.push('QR code B');\nif (!errOf(grab('Delete Short Link'))) removed.push('short link');\nif (!errOf(grab('Delete Folder'))) removed.push('folder');\nlines.push(pad('cleanup') + (removed.length === 4 ? 'ok    ' : 'FAIL  ') + removed.length + ' of 4 deletable objects removed: ' + (removed.join(', ') || 'none'));\n\nnotes.push('Scans are counted when QRSalt serves the redirect, so getScans may still read 0 if counting lags this run.');\n\nconst stamp = (() => { try { return $('Prepare').first().json.stamp; } catch (e) { return 'unknown'; } })();\nconst report = [\n  'QRSalt n8n node test — ' + new Date().toISOString() + ' — run ' + stamp,\n  ''.padEnd(64, '-'),\n  ...lines,\n  ''.padEnd(64, '-'),\n  'FAILURES: ' + (failures.length ? failures.length : 'none'),\n  ...failures.map((f) => '  - ' + f),\n  'NOTES:',\n  ...notes.map((t) => '  - ' + t),\n].join('\\n');\n\nreturn [{ json: { report } }];"
      },
      "id": "summary",
